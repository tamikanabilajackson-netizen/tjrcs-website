# Copy to .env.local and fill in once the backend (see backend/README.md) is deployed.
NEXT_PUBLIC_BACKEND_URL=https://your-backend-url.com

# Endpoint for the Yeriel chat widget. Optional: if unset the widget falls
# back to https://tjrcs-backend.onrender.com/api/chat. Override it to point at
# a local or staging backend. NEXT_PUBLIC_ vars are baked in at build time, so
# changing this on Vercel needs a redeploy.
NEXT_PUBLIC_CHAT_API_URL=https://tjrcs-backend.onrender.com/api/chat
